+#[derive(serde::Deserialize)]
+struct CangwuUpdateRequest {
+    action: String,
+    enabled: Option<bool>,
+    #[serde(default)]
+    automatic: bool,
+}
+
+async fn handle_cangwu_update(
+    State(state): State<WebState>,
+    headers: HeaderMap,
+    Json(request): Json<CangwuUpdateRequest>,
+) -> impl IntoResponse {
+    // A foreign web page cannot use the local update bridge via permissive CORS.
+    if !is_same_origin_ws_request(&headers) {
+        return (StatusCode::FORBIDDEN, Json(serde_json::json!({"error": "Origin not allowed"}))).into_response();
+    }
+    match crate::commands::cangwu_update::run(state.app_handle, state.maa_state,
+        request.action, request.enabled, request.automatic).await {
+        Ok(value) => Json(value).into_response(),
+        Err(error) => (StatusCode::BAD_REQUEST, Json(serde_json::json!({"error": error}))).into_response(),
+    }
+}
